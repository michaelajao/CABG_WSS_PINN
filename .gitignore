# =============================================================================
# Ablation artifacts (see scripts/ablation_pilot.py)
# =============================================================================
# 20-epoch run that verifies the 2x2 driver end to end.
reports/ablation_smoke/
# Field and loss plots for the pilot: ~40 MB, reproduced by re-running the
# driver. The per-config metrics under results/ are force-added despite the
# reports/**/_*/ rule above, which is intended for scratch directories.
reports/ablation_pilot/figures/
# 23 MB raw console log; the gzipped copy is committed alongside it.
reports/ablation_pilot/run.log
